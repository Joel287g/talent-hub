# PORT
PORT = number

# DATABASE
DB_NAME = string
DB_USER = string
DB_PASSWORD = string
DB_CLUSTER = string
DB_URI = string

# SECURITY
API_KEY = string

JWT_EXPIRATION_TIME = string
JWT_AUDIENCE = string
JWT_SECRET = string

# FIREBASE (cuenta de servicio del Admin SDK)
FIREBASE_PROJECT_ID = string
FIREBASE_CLIENT_EMAIL = string
FIREBASE_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opcional, solo en desarrollo: script `npm run auth:token` (obtener el JWT sin frontend)
# FIREBASE_WEB_API_KEY = string
# FIREBASE_TEST_EMAIL = string
# FIREBASE_TEST_PASSWORD = string

# Opcional, solo en desarrollo: usa el emulador local y no requiere CLIENT_EMAIL ni PRIVATE_KEY
# FIREBASE_AUTH_EMULATOR_HOST = 127.0.0.1:9099
