{
  "name": "talent-hub",
  "version": "0.0.1",
  "description": "Plataforma centralizada para conectar talento artístico, instructores y academias mediante portafolios multimedia dinámicos.",
  "author": "Joel287g",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joel287g/talent-hub.git"
  },
  "homepage": "https://github.com/Joel287g/talent-hub.git#readme",
  "scripts": {
    "check:imports": "npx tsx src/scripts/check-imports.script.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,html,css}\"",
    "start:dev": "cross-env NODE_ENV=development nest start --watch"
  },
  "engines": {
    "node": ">=26.8.0",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "mongoose": "^9.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
